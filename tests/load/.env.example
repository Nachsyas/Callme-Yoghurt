# ==============================================================================
# Callme Yoghurt — Load & Stress Test Environment Variables (Phase 1.3A)
# ==============================================================================
# SECURITY INVARIANT: Never commit real production credentials or production secrets.
# Use staging or local development URLs only.

# Target Endpoints
STAGING_URL=http://127.0.0.1:3000
ADMIN_URL=http://127.0.0.1:3000
ERP_INTERNAL_URL=http://127.0.0.1:8000

# Test Personas & Credentials (Synthetic Data Only)
TEST_CUSTOMER_EMAIL=loadtest.customer@callmeyoghurt.com
TEST_ADMIN_EMAIL=admin@callmeyoghurt.com
TEST_ADMIN_PASSWORD=SyntheticLoadTestPassword123!

# Target Catalog Variant (UUID from Authoritative Catalog)
TEST_VARIANT_ID=018f6c38-8c50-711e-b8d4-53a8be77e440

# Idempotency Key Template (Base prefix for stress testing)
TEST_IDEMPOTENCY_KEY=k6-stress-idemp-key-baseline

# Test Execution Profile: set to 'true' for full production stages (12+ minutes), or 'false' for quick smoke (10s)
FULL_RUN=false
