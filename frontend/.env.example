# Callme Yoghurt Frontend — Deployment Environment Configuration Template
# For local development: copy to .env.local
# For Vercel production/staging deployments: configure in Vercel Project Settings > Environment Variables

# Next.js Environment
NODE_ENV=development

# Reverse Proxy Trust Configuration
# Set to "true" only when running behind trusted edge proxies (e.g. Cloudflare, AWS ALB)
TRUST_PROXY=false

# ==============================================================================
# SECTION A: CUSTOMER STOREFRONT DEPLOYMENT (callmeyoghurt.com / staging)
# ==============================================================================
# Required Application Mode:
NEXT_PUBLIC_APP_MODE=storefront

# Upstream Laravel ERP Service Configuration (Private Server-Side Only)
# SECURITY INVARIANT: NEVER prefix with NEXT_PUBLIC_. These are never bundled to client.
ERP_INTERNAL_URL=http://localhost:8000
ERP_SERVICE_TOKEN=callme_dev_service_secret_token

# Distributed Rate Limiting (Redis)
# In development: Optional (uses memory rate limiter fallback).
# In production: MANDATORY. Missing REDIS_URL causes rate limiting to FAIL CLOSED.
# SECURITY INVARIANT: NEVER prefix with NEXT_PUBLIC_.
REDIS_URL=redis://:callme_dev_redis_insecure_password@127.0.0.1:6379

# ==============================================================================
# SECTION B: ADMINISTRATIVE CONSOLE DEPLOYMENT (admin.callmeyoghurt.com / admin-staging)
# ==============================================================================
# Required Application Mode:
# NEXT_PUBLIC_APP_MODE=admin

# Admin Session Signing Secret (HMAC-SHA256, Private Server-Side Only)
# In production: MANDATORY (minimum 32 characters high-entropy). Missing secret FAILS CLOSED.
# SECURITY INVARIANT: NEVER prefix with NEXT_PUBLIC_.
ADMIN_SESSION_SECRET=callme_dev_admin_session_secret_32_chars_min

# Upstream Laravel ERP Service Configuration for Admin API Authentication
# ERP_INTERNAL_URL=http://localhost:8000

# ==============================================================================
# SECTION C: PAYMENT INFRASTRUCTURE CONFIGURATION (Phase 1.7C.14)
# ==============================================================================
# Payment Provider Selection: 'manual_qris' | 'midtrans' | 'xendit'
PAYMENT_PROVIDER=manual_qris

# Midtrans Configuration (Private Server-Side Only, do not expose with NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Xendit Configuration (Private Server-Side Only, do not expose with NEXT_PUBLIC_)
XENDIT_SECRET_KEY=

# ==============================================================================
# SECTION D: BITESHIP SHIPPING INTEGRATION (Phase 1.7C.19)
# ==============================================================================
# Biteship API Key (Private Server-Side Only, NEVER prefix with NEXT_PUBLIC_)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com

# Authoritative Origin Configuration (Bambu Apus, Cipayung, Jakarta Timur)
# Note: Values must be configured by store owner. Do NOT fabricate production coordinates.
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_LATITUDE=
BITESHIP_ORIGIN_LONGITUDE=
BITESHIP_ORIGIN_AREA_ID=

# ==============================================================================
# SECTION E: SERVICE FEE CONFIGURATION (Phase 1.7C.19A)
# ==============================================================================
# Biaya Layanan: Digital service and order processing fee (Integer IDR only, non-negative)
# Private Server-Side Only. Never prefix with NEXT_PUBLIC_. Empty/missing will fail safe.
SERVICE_FEE_IDR=

# ==============================================================================
# SECURITY INVARIANTS FOR ALL VERCEL DEPLOYMENTS:
# - ONLY NEXT_PUBLIC_APP_MODE may be exposed to the browser client.
# - ERP_SERVICE_TOKEN, ADMIN_SESSION_SECRET, REDIS_URL, MIDTRANS_SERVER_KEY,
#   XENDIT_SECRET_KEY, and BITESHIP_API_KEY must NEVER be client-exposed.
# - Storefront deployment isolates and blocks /admin access.
# - Admin deployment enforces cryptographic session boundary on all /admin/* routes.
# ==============================================================================

