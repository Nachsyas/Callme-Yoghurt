# Callme Yoghurt Frontend — Environment Configuration Template
# Copy to .env.local for local development.

# Next.js Application Environment
NODE_ENV=development

# Upstream Laravel ERP Service Configuration
ERP_INTERNAL_URL=http://localhost:8000
ERP_SERVICE_TOKEN=callme_dev_service_secret_token

# Distributed Rate Limiting (Redis)
# Format: redis://[:password@]host[:port][/db] or rediss:// for TLS
# In development (NODE_ENV=development): Optional (uses DevMemoryRateLimiter by default).
# In production (NODE_ENV=production): MANDATORY. Missing REDIS_URL causes rate limiting to FAIL CLOSED.
REDIS_URL=redis://:callme_dev_redis_insecure_password@127.0.0.1:6379

# Reverse Proxy Trust Configuration
# Set to "true" only when running behind trusted edge proxies (e.g. Cloudflare, AWS ALB, Nginx)
TRUST_PROXY=false
# Application Deployment Separation (Phase 1.2A)
# Allowed values: "storefront" | "admin"
# In local development: Optional (defaults to unified mode allowing both / and /admin).
# In production Vercel deployment:
#   - Storefront deployment MUST set NEXT_PUBLIC_APP_MODE=storefront (strictly isolates and blocks /admin access).
#   - Admin deployment MUST set NEXT_PUBLIC_APP_MODE=admin (dedicated privileged console deployment).
NEXT_PUBLIC_APP_MODE=storefront

# Admin Session Signing Secret (HMAC-SHA256)
# In production (NODE_ENV=production): MANDATORY. Must be a 32+ character high-entropy secret. Missing secret FAILS CLOSED.
# In development (NODE_ENV=development): Falls back to internal dev secret if omitted.
ADMIN_SESSION_SECRET=callme_dev_admin_session_secret_32_chars_min
