APP_NAME="Callme Yoghurt ERP Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Primary System of Record — PostgreSQL (ADR-0001)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=callme_yoghurt_dev
DB_USERNAME=callme_dev_user
DB_PASSWORD=callme_dev_insecure_password
DB_SSLMODE=prefer

# Ephemeral Infrastructure — Redis (ADR-0001)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=callme_dev_redis_insecure_password
REDIS_PORT=6379

# Queue & Cache
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

# PII Protection (HMAC-SHA256 Blind Index Key)
# Must be 32+ characters cryptographic secret. Unconfigured key fails closed.
CRM_PII_BLIND_INDEX_KEY=

# Internal Service Authentication (BFF -> ERP Core)
# Shared service bearer token. Unconfigured token fails closed.
ERP_SERVICE_TOKEN=

# Retail Checkout & Inventory Reservation
# Authoritative warehouse code used for retail stock reservation. Unconfigured fails closed.
ERP_FULFILLMENT_WAREHOUSE_CODE=

# Checkout Request Fingerprint Key
# Secret key for HMAC-SHA256 idempotent request hashing. Unconfigured fails closed.
CHECKOUT_FINGERPRINT_KEY=
# Distributed Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# In development (APP_ENV=local/testing): Optional (can use local/fake driver or local MinIO).
# In production (APP_ENV=production): MANDATORY. Missing access key, secret key, or bucket causes object storage to FAIL CLOSED.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PATH_STYLE=true

# Administrative Identity & Session Security (Phase 1.2B)
# Secret key for HMAC-SHA256 admin session signing. Must match frontend secret.
# In production: MANDATORY (minimum 16 chars). Unconfigured key causes admin authentication to FAIL CLOSED.
ADMIN_SESSION_SECRET=
HASH_DRIVER=argon2id

# Initial OWNER Provisioning for Development/Staging Seeder (Optional)
# Leave blank in production. Command `php artisan callme:create-owner` is preferred.
INITIAL_OWNER_NAME="Callme ERP Owner"
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
