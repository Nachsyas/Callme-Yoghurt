# ==============================================================================
# Callme Yoghurt ERP Core — Production Environment Contract
# Phase 1.7C.21 Production Deployment Readiness
#
# INVARIANTS:
# 1. NEVER commit real secrets or credentials into version control.
# 2. In production, unconfigured security secrets cause the ERP to FAIL CLOSED.
# 3. No fallback or default secrets are permitted in production mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
APP_NAME="Callme Yoghurt ERP Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-erp.callmeyoghurt.com
APP_TIMEZONE=Asia/Jakarta
PORT=8000
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# 2. POSTGRESQL (Authoritative System of Record — ADR-0001)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# Alternative: DB_URL=postgres://user:password@host:5432/database?sslmode=prefer

# ------------------------------------------------------------------------------
# 3. REDIS (Ephemeral Infrastructure: Cache, Rate Limiting, Ephemeral Quotes)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Alternative: REDIS_URL=redis://:password@host:6379
CACHE_STORE=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis

# ------------------------------------------------------------------------------
# 4. SECURITY (Cryptographic & S2S Authentication Secrets)
# Must be generated using high-entropy CSPRNG (e.g. openssl rand -hex 32).
# Missing or empty keys will cause the application to FAIL CLOSED.
# ------------------------------------------------------------------------------
# Blind index key for encrypted PII search (HMAC-SHA256, minimum 32 chars):
CRM_PII_BLIND_INDEX_KEY=

# Internal Service-to-Service authentication (BFF -> ERP Core, minimum 32 chars):
ERP_SERVICE_TOKEN=

# Request fingerprint secret for checkout idempotency (HMAC-SHA256, minimum 32 chars):
CHECKOUT_FINGERPRINT_KEY=

# Admin session signing secret (HMAC-SHA256, minimum 16 chars):
ADMIN_SESSION_SECRET=
HASH_DRIVER=argon2id

# ------------------------------------------------------------------------------
# 5. FULFILLMENT
# ------------------------------------------------------------------------------
ERP_FULFILLMENT_WAREHOUSE_CODE=WH-MAIN

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (S3-Compatible: AWS S3, Cloudflare R2, MinIO)
# Optional during initial ERP boot and read-only checkout operations.
# MANDATORY when file upload or unboxing video functionality is invoked.
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 7. SHIPPING (Biteship Rates API Integration)
# ------------------------------------------------------------------------------
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_TIMEOUT_SECONDS=8
SHIPPING_QUOTE_TTL_SECONDS=900
SHIPPING_CACHE_STORE=redis

# ------------------------------------------------------------------------------
# 8. OWNER-BLOCKED BUSINESS CONFIGURATION
# DO NOT FABRICATE. Must be provided and verified by business owner.
# If null/unconfigured, checkout or rate quoting fails closed with clear warnings.
# ------------------------------------------------------------------------------
# Biaya Layanan in IDR (integer, e.g. 1000):
SERVICE_FEE_IDR=

# Authoritative origin address (Bambu Apus, Cipayung, Jakarta Timur):
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_ORIGIN_LATITUDE=
SHIPPING_ORIGIN_LONGITUDE=
SHIPPING_ORIGIN_VERIFIED=false

# ------------------------------------------------------------------------------
# 9. CONTAINER ORCHESTRATION & DEPLOYMENT FLAGS
# ------------------------------------------------------------------------------
AUTO_MIGRATE=false
VALIDATE_CONFIG=true
CORS_ALLOWED_ORIGINS=
