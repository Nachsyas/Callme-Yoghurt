# ==============================================================================
# Callme Yoghurt ERP Core — Production Environment Configuration (.env)
# Mandatory: Fail-closed on missing secrets. Zero dummy or fallback credentials.
# ==============================================================================

APP_NAME="Callme Yoghurt ERP Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp-internal.callmeyoghurt.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Authoritative PostgreSQL 16 Persistence (System of Record)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=callme_yoghurt_prod
DB_USERNAME=callme_erp_user
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Redis 7 Coordination, Rate Limiting & Asynchronous Queue
# ------------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Cryptographic Keys & Zero-Trust Service Tokens
# ------------------------------------------------------------------------------
# CRM PII Blind Index Key (Mandatory 32-character secret for HMAC-SHA256 phone search)
CRM_PII_BLIND_INDEX_KEY=

# ERP Service Bearer Token (Mandatory secret for Next.js BFF -> Laravel ERP communication)
ERP_SERVICE_TOKEN=

# Checkout Idempotency & Transaction Fingerprint Key (Mandatory 32-character secret)
CHECKOUT_FINGERPRINT_KEY=

# Administrative Session Signing Secret (Mandatory 64-character hex secret matching Vercel Admin)
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# Enterprise Cold Chain Fulfillment Warehouse
# ------------------------------------------------------------------------------
DEFAULT_FULFILLMENT_WAREHOUSE_CODE=WH-COLD-JKT-01
DEFAULT_FULFILLMENT_WAREHOUSE_NAME="Jakarta Central Cold Chain Hub"
